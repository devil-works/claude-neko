{
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "bash ${CLAUDE_PLUGIN_ROOT}/bin/pane-open.sh", "timeout": 5}]}],
    "SessionEnd": [{"hooks": [
      {"type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/busy.py end", "timeout": 5, "async": true},
      {"type": "command", "command": "bash ${CLAUDE_PLUGIN_ROOT}/bin/pane-close.sh", "timeout": 5}
    ]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/busy.py prompt", "timeout": 5, "async": true}]}],
    "PreToolUse": [{"hooks": [{"type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/busy.py busy", "timeout": 5, "async": true}]}],
    "PostToolUse": [{"hooks": [{"type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/busy.py busy", "timeout": 5, "async": true}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/busy.py idle", "timeout": 5, "async": true}]}],
    "Notification": [{"hooks": [{"type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/busy.py wait", "timeout": 5, "async": true}]}],
    "PermissionRequest": [{"hooks": [{"type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/busy.py wait", "timeout": 5, "async": true}]}],
    "SubagentStart": [{"hooks": [{"type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/busy.py agent_start", "timeout": 5, "async": true}]}],
    "SubagentStop": [{"hooks": [{"type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/busy.py agent_stop", "timeout": 5, "async": true}]}]
  }
}
